# Copy to `.env` at the repo root and fill in. `.env` is gitignored — never commit it.

# --- SigNoz -------------------------------------------------------------------
# Admin user registered on first launch of your SigNoz instance.
SIGNOZ_UI_EMAIL=you@example.com
SIGNOZ_UI_PASSWORD=

# Service-account API key, used by the SigNoz MCP server and by the dashboard
# provisioning scripts. Create it with:
#   POST /api/v1/service_accounts            -> creates the account
#   POST /api/v1/service_accounts/{id}/keys  -> mints the key
# then attach the `signoz-admin` role, or every data route returns 403 while the
# identity endpoints still return 200. See infra/signoz/README.md.
#
# NOTE: the generated key can contain an `=`. Split on the FIRST `=` only when
# parsing this file (`cut -d= -f2-`), or you get a silent 401.
SIGNOZ_API_KEY=

# --- LLM ----------------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Free tier is 20 requests/day/model and each incident spends 2 (Diagnosis + Fix).
# Quota is per model, so switching GEMINI_MODEL grants a fresh allowance.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. Override without a rebuild if you hit
# the daily quota. Verified alternatives: gemini-flash-latest, gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-3.6-flash

# --- Optional overrides -------------------------------------------------------
# Defaults are correct for a local Foundry deployment; set only if yours differs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
