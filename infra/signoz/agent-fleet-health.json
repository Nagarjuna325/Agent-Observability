{
  "title": "AgentOps — Agent Fleet Health",
  "description": "Observability of the SDLC agent swarm itself (service sdlc-agents): what each agent step did, how long it took, what it spent on LLM tokens, which MCP tools it called, and how often it failed. Panels that need span attributes (tokens, agent name, tool name, failure reason) use the traces data source, because span metrics only carry service.name/operation/span.kind/status.code.",
  "tags": ["agentops", "sdlc-agents"],
  "version": "v5",
  "uploadedGrafana": false,
  "panelMap": {},
  "variables": {},
  "layout": [
    { "i": "a0000001-0000-4000-8000-000000000001", "x": 0, "y": 0, "w": 12, "h": 6, "moved": false, "static": false },
