      "query": {
        "id": "a0000004-0000-4000-8000-0000000000a4",
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "traces",
              "disabled": false,
              "legend": "",
              "stepInterval": 60,
              "aggregations": [
                { "expression": "sum(gen_ai.usage.input_tokens)", "alias": "input_tokens" },
                { "expression": "sum(gen_ai.usage.output_tokens)", "alias": "output_tokens" }
              ],
              "filter": { "expression": "service.name = 'sdlc-agents' AND gen_ai.request.model EXISTS" },
              "groupBy": [
                { "key": "gen_ai.agent.name", "dataType": "string", "type": "attribute", "id": "gen_ai.agent.name--string--attribute--false", "isColumn": false, "isJSON": false }
