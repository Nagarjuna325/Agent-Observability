    {
      "id": "a0000004-0000-4000-8000-000000000004",
      "title": "LLM tokens by agent",
      "description": "Token spend per agent, from gen_ai.usage.* span attributes. Only spans that carry gen_ai.request.model are counted, which excludes the non-LLM agents (Monitor makes zero LLM calls by design).",
      "panelTypes": "table",
      "yAxisUnit": "none",
      "timePreferance": "GLOBAL_TIME",
      "fillSpans": false,
      "isStacked": false,
      "isLogScale": false,
