  "widgets": [
    {
      "id": "a0000001-0000-4000-8000-000000000001",
      "title": "Agent step invocations",
      "description": "How many times each agent step ran. Span metrics are enough here because `operation` already encodes agent + step (agent.diagnosis.run, agent.fix.restart, ...).",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "timePreferance": "GLOBAL_TIME",
      "fillSpans": false,
      "isStacked": false,
      "isLogScale": false,
      "stackedBarChart": false,
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": 0,
      "softMin": 0,
      "bucketCount": 30,
      "bucketWidth": 0,
      "columnUnits": {},
      "thresholds": [],
      "query": {
        "id": "a0000001-0000-4000-8000-0000000000a1",
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "metrics",
              "disabled": false,
              "legend": "{{operation}}",
              "stepInterval": 60,
              "aggregations": [
                {
                  "metricName": "signoz_calls_total",
                  "timeAggregation": "increase",
                  "spaceAggregation": "sum"
                }
              ],
              "filter": { "expression": "service.name = 'sdlc-agents' AND operation LIKE 'agent.%'" },
              "groupBy": [
                { "key": "operation", "dataType": "string", "type": "attribute", "id": "operation--string--attribute--false", "isColumn": false, "isJSON": false }
              ],
              "having": { "expression": "" },
              "functions": [],
              "limit": null,
              "orderBy": []
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
